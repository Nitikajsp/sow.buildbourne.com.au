# <IfModule mime_module>
#     # Set PHP Version (Change to your required version)
#   AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
# AddHandler application/x-httpd-alt-php83 .php
# </IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect to public folder only if the request is not already inside public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “alt-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-alt-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
